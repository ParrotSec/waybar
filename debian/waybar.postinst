#!/bin/sh
set -e

# Older Parrot revisions enabled waybar.service automatically. That conflicts
# with the Hyprland-managed startup path, so remove only the legacy enablement.
if [ "$1" = configure ] && [ -n "${2:-}" ] && [ -z "${DPKG_ROOT:-}" ] &&
   dpkg --compare-versions "$2" lt 0.16.0-0parrot4; then
    deb-systemd-helper --user disable waybar.service >/dev/null || true
fi

#DEBHELPER#

exit 0
