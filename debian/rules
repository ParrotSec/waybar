#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=meson

override_dh_auto_configure:
	dh_auto_configure -- \
		-Dtests=disabled \
		-Dman-pages=enabled \
		-Dcava=disabled \
		-Dniri=true \
		-Dmango=true \
		-Dumbriel=true \
		-Drfkill=enabled

override_dh_auto_test:
